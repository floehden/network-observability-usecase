# Copy to local.mk (git-ignored) to override Makefile defaults on this machine.
# Anything here can also be passed on the command line: make deploy VAR=value

# How gNMIc reaches the devices. Auto-selected: 'host' on OrbStack, else 'mgmt'.
#   mgmt - dial containerlab mgmt IPs directly (cluster nodes on the clab network)
#   host - dial GNMI_HOST_IP on each node's published port
# GNMI_MODE = host
# GNMI_HOST_IP = 192.168.139.126

# Local ports used for kubectl port-forwards (make targets and `make ui`).
# INFRAHUB_LOCAL_PORT = 8000
# GITEA_LOCAL_PORT = 3030
# GRAFANA_LOCAL_PORT = 3001
# PROMETHEUS_LOCAL_PORT = 9091

# kind cluster name used by `make up`, `make kind-up` and `make lab-connect`.
# KIND_CLUSTER = netobs

# How containerlab is invoked. Defaults to `sudo containerlab` when installed,
# otherwise the ghcr.io/srl-labs/clab container image.
# CLAB = containerlab

# Python used for the host-side scripts (defaults to .venv if present).
# PYTHON = python3
# INFRAHUBCTL = infrahubctl
